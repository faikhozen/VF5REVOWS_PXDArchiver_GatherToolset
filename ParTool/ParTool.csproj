<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>VF5REVOWS_mod_compiler</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.6.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="Yarhl" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\pxdArchiver\ParManager\ParLibrary\ParLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\vf5revows_dummy_gmds\*.gmd" Link="EmbeddedDummyGmds\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\yk_gmd_blender\**\*.py" Link="EmbeddedYkGmdBlender\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="EmbeddedScanner\*.py" Link="EmbeddedScanner\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

